# 统一使用 LF，避免 Windows 检出时把脚本改成 CRLF（.sh 在 Linux 下会因 CRLF 报错）
* text=auto eol=lf

# Windows 批处理必须是 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不要做换行转换
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.exe binary
*.dll binary
*.pyd binary
*.db binary
*.zip binary
*.gz binary
